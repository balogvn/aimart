{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make lint)",
      "Bash(make type)",
      "Bash(make test)",
      "Bash(make check)",
      "Bash(make fmt)",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/ruff *)",
      "Bash(.venv/bin/mypy *)",
      "Bash(uv run --frozen pytest *)",
      "Bash(uv run --frozen ruff *)",
      "Bash(uv run --frozen mypy *)",
      "Bash(bash .claude/hooks/test_hooks.sh)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(gcloud run deploy *)",
      "Bash(.venv/bin/pytest * -m testnet*)",
      "Bash(uv publish *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git clean -fdx *)",
      "Bash(git clean -xfd *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(env)",
      "Bash(printenv)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(.wallets/**)",
      "Read(.local/**)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(~/.ssh/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Edit(.wallets/**)",
      "Edit(*.pem)",
      "Edit(*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\"",
            "timeout": 15,
            "statusMessage": "Checking the command for secrets and spends"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_python.py\"",
            "timeout": 60,
            "statusMessage": "ruff fix + format"
          }
        ]
      }
    ]
  }
}
